# Copiá este archivo como .env y completá tus claves.  NUNCA subas .env a GitHub.

# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Opcional: servidor compatible con OpenAI. Vacío = API oficial de OpenAI.
# Para Ollama local (gratis):  OPENAI_BASE_URL=http://localhost:11434/v1
#                              OPENAI_API_KEY=ollama   (cualquier texto: Ollama no la valida)
#                              OPENAI_MODEL=llama3.2:3b
OPENAI_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Parámetros de generación (opcionales, validados con Pydantic) ---
LLM_TEMPERATURE=0.7      # 0 a 2 (Anthropic se ajusta a máx. 1)
LLM_MAX_TOKENS=512       # > 0
LLM_TIMEOUT=60           # segundos por request
LLM_MAX_RETRIES=3        # reintentos ante 429 / red / 5xx
LLM_MAX_CONCURRENCY=5    # llamadas simultáneas como máximo

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING
